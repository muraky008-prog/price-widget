<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/sub"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnRefresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="새로고침"
            android:padding="6dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btnList"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_bg"
            android:contentDescription="종목 목록"
            android:padding="6dp"
            android:src="@drawable/ic_list" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="bottom"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingBottom="3dp"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/levels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/labelRes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="@color/up"
            android:textSize="11sp"
            android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rowR4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameR4" style="@style/RowName" />
                <TextView android:id="@+id/valR4" style="@style/RowVal" />
                <TextView android:id="@+id/pctR4" style="@style/RowPct" android:textColor="@color/up" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowR3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameR3" style="@style/RowName" />
                <TextView android:id="@+id/valR3" style="@style/RowVal" />
                <TextView android:id="@+id/pctR3" style="@style/RowPct" android:textColor="@color/up" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowR2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameR2" style="@style/RowName" />
                <TextView android:id="@+id/valR2" style="@style/RowVal" />
                <TextView android:id="@+id/pctR2" style="@style/RowPct" android:textColor="@color/up" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowR1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameR1" style="@style/RowName" />
                <TextView android:id="@+id/valR1" style="@style/RowVal" />
                <TextView android:id="@+id/pctR1" style="@style/RowPct" android:textColor="@color/up" />
            </LinearLayout>

        <TextView
            android:id="@+id/tvNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/now_bg"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rowS1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameS1" style="@style/RowName" />
                <TextView android:id="@+id/valS1" style="@style/RowVal" />
                <TextView android:id="@+id/pctS1" style="@style/RowPct" android:textColor="@color/down" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowS2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameS2" style="@style/RowName" />
                <TextView android:id="@+id/valS2" style="@style/RowVal" />
                <TextView android:id="@+id/pctS2" style="@style/RowPct" android:textColor="@color/down" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowS3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameS3" style="@style/RowName" />
                <TextView android:id="@+id/valS3" style="@style/RowVal" />
                <TextView android:id="@+id/pctS3" style="@style/RowPct" android:textColor="@color/down" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowS4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <TextView android:id="@+id/nameS4" style="@style/RowName" />
                <TextView android:id="@+id/valS4" style="@style/RowVal" />
                <TextView android:id="@+id/pctS4" style="@style/RowPct" android:textColor="@color/down" />
            </LinearLayout>

        <TextView
            android:id="@+id/labelSup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/down"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sub"
        android:textSize="10sp" />
</LinearLayout>